@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="container">
    <h2>Bienvenido/a</h2>
    <p>Usuario: <strong>@Model.UserName</strong></p>

    <div class="muted">Claims:</div>
    <ul>
        @foreach (var c in User.Claims.Take(10))
        {
            <li>@c.Type = @c.Value</li>
        }
    </ul>

    <p><a class="btn primary" href="/Auth/Logout">Salir</a></p>
</div>
